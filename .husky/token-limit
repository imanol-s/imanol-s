#!/usr/bin/env bash
# pre-commit: reject staged files larger than MAX_TOKENS tokens (tokens = bytes / 4).
#
# Checks only the staged blob (what will actually be committed), not the working tree.
# Skips files that are not agent-authored: lockfiles, codegen, minified/vendored/build
# output, binaries, data fixtures, and anything marked linguist-generated or
# linguist-vendored in .gitattributes.
#
# Files already over the limit at HEAD are grandfathered: they stay editable, but no
# file may newly cross the limit. New files and files crossing the limit are blocked.
#
# Bypass for a single commit:  SKIP_TOKEN_LIMIT=1 git commit ...
set -euo pipefail

MAX_TOKENS="${MAX_TOKENS:-5000}"
MAX_BYTES=$(( MAX_TOKENS * 4 ))

if [ "${SKIP_TOKEN_LIMIT:-0}" = "1" ]; then
    exit 0
fi

# --- Non-agent-authored files -------------------------------------------------
# Basename patterns (lockfiles and other tool-owned files).
SKIP_BASENAMES=(
    package-lock.json yarn.lock pnpm-lock.yaml bun.lockb bun.lock
    uv.lock poetry.lock Pipfile.lock pdm.lock
    Cargo.lock Gemfile.lock composer.lock go.sum go.work.sum
    packages.lock.json flake.lock mix.lock pubspec.lock
    Podfile.lock gradle.lockfile
)
# Path regexes (ERE) for codegen, minified, vendored, build output, binaries, data.
SKIP_PATH_REGEX='(^|/)(node_modules|vendor|dist|build|out|target|__snapshots__|\.venv|coverage|\.next|\.nuxt|migrations)/|\.(min\.js|min\.css|bundle\.js|map|snap|lock|generated\.[a-z]+|g\.[a-z]+|pb\.go|pb2\.py|pb2_grpc\.py|d\.ts|graphql\.ts|openapi\.json|csv|tsv|parquet|xlsx|xls|sqlite|db|ipynb|png|jpe?g|gif|webp|svg|ico|pdf|woff2?|ttf|otf|eot|zip|gz|tar|bin|exe|dll|so|dylib|wasm)$'
# Markers that a file was emitted by a tool (checked in the first 10 lines).
GENERATED_MARKER_REGEX='@generated|DO NOT EDIT|do not edit|[Aa]uto-?generated|[Gg]enerated by|This file is generated|Code generated'

is_skipped() {
    local path="$1" base
    base="${path##*/}"
    for b in "${SKIP_BASENAMES[@]}"; do
        [ "$base" = "$b" ] && return 0
    done
    [[ "$path" =~ $SKIP_PATH_REGEX ]] && return 0
    # .gitattributes: linguist-generated / linguist-vendored
    local attrs
    attrs="$(git check-attr linguist-generated linguist-vendored -- "$path" 2>/dev/null || true)"
    [[ "$attrs" == *": set"* || "$attrs" == *": true"* ]] && return 0
    # Binary (git reports "-" for numstat on binary blobs)
    local numstat
    numstat="$(git diff --cached --numstat -- "$path" | head -n1 || true)"
    [[ "$numstat" == -* ]] && return 0
    # Generated-code header marker in the staged content
    local header
    header="$(git show ":$path" 2>/dev/null | head -n 10 || true)"
    if grep -Eq "$GENERATED_MARKER_REGEX" <<<"$header"; then
        return 0
    fi
    return 1
}

# --- Scan staged files ---------------------------------------------------------
violations=()
grandfathered=()
while IFS= read -r -d '' path; do
    is_skipped "$path" && continue
    bytes="$(git cat-file -s ":$path" 2>/dev/null || echo 0)"
    tokens=$(( bytes / 4 ))
    [ "$tokens" -gt "$MAX_TOKENS" ] || continue
    # Grandfather: already over the limit at HEAD.
    head_bytes="$(git cat-file -s "HEAD:$path" 2>/dev/null || echo 0)"
    if [ "$head_bytes" -gt "$MAX_BYTES" ]; then
        grandfathered+=("$path")
        continue
    fi
    violations+=("$path|$bytes|$tokens")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "${#grandfathered[@]}" -gt 0 ]; then
    echo "token-limit: skipped ${#grandfathered[@]} file(s) already over ${MAX_TOKENS} tokens at HEAD: ${grandfathered[*]}" >&2
fi

[ "${#violations[@]}" -eq 0 ] && exit 0

# --- Report --------------------------------------------------------------------
{
    echo "BLOCKED: staged file(s) exceed ${MAX_TOKENS} tokens (tokens = bytes / 4, limit ${MAX_BYTES} bytes)."
    echo
    printf '  %-10s %-10s %s\n' TOKENS BYTES FILE
    for v in "${violations[@]}"; do
        IFS='|' read -r p b t <<<"$v"
        printf '  %-10s %-10s %s\n' "$t" "$b" "$p"
    done
    cat <<'MSG'

Large files are hard for agents and reviewers to load and edit reliably. Each file above
is new or has just crossed the limit. Split it so that every resulting file is under the
limit, then re-stage and commit again.

How to split:

  1. Pick seams, not line counts. Group the file's contents by responsibility: each
     class, each cohesive set of functions, each config section, each documentation
     topic becomes a candidate for its own file. Do not cut mid-function or mid-section.

  2. Create one new file per group, next to the original, named for what it contains
     (e.g. parser.py -> parser/tokenizer.py, parser/grammar.py, parser/ast.py;
      README.md -> README.md plus docs/setup.md, docs/usage.md).

  3. Move the code, do not copy it. Each definition lives in exactly one file.
     Leave the original as the public entry point that imports/re-exports from the
     new files, so existing callers and links keep working.

  4. Fix imports and references. Update every import, include, or link that pointed
     at the moved content. For docs, replace moved sections with a one-line link.

  5. Verify. Run the project's lint, type-check, and tests so the move is proven
     behavior-neutral before committing.

  6. Re-check sizes before staging:
       git add <files>
       git diff --cached --name-only -z | xargs -0 -I{} sh -c 'echo "$(( $(git cat-file -s :{}) / 4 )) {}"' | sort -rn | head

  7. Commit each logical split as its own commit if the move is large; small, reviewable
     commits are easier to verify than one big reshuffle.

If the file is tool-generated rather than authored (lockfile, codegen, data fixture),
mark it in .gitattributes so the hook ignores it:
       path/to/file linguist-generated=true

To bypass once, with a reason in the commit message:
       SKIP_TOKEN_LIMIT=1 git commit ...
MSG
} >&2
exit 1
