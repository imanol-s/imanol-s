---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import { formatDate } from "../utils/formatDate";

interface Props {
  id: string;
  title: string;
  description: string;
  publishDate: Date;
  tags: string[];
  cover: {
    src: ImageMetadata;
    alt?: string;
  };
}

const { id, title, description, publishDate, tags, cover } =
  Astro.props as Props;
---

<a
  href={`/blog/${id}`}
  class="post-card group flex flex-col md:flex-row md:items-center gap-8 focus-ring"
>
  <div
    class="flex-none w-full md:w-40 h-40 overflow-hidden border border-slate-200 dark:border-slate-800"
  >
    <Picture
      transition:name={`${id}-image`}
      src={cover.src}
      alt={cover.alt ?? title}
      class="w-full h-full object-cover"
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[160, 320]}
      sizes="(max-width: 768px) 100vw, 160px"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="flex flex-col gap-2">
    <div class="post-metadata flex flex-wrap items-center gap-1.5">
      <div class="flex items-center gap-1">
        <Icon name="time-line" class="w-4 h-4 text-slate-500" />
        <time
          class="text-sm text-slate-500"
          datetime={publishDate.toISOString()}
        >
          {formatDate(publishDate)}
        </time>
      </div>
      <span class="text-slate-500"> &middot; </span>
      <div class="flex gap-2">
        {tags.map((tag) => <span class="text-sm text-slate-500">#{tag}</span>)}
      </div>
    </div>
    <h3
      class="post-title text-2xl font-body font-semibold text-slate-900 dark:text-white"
    >
      {title}<span class="post-arrow" aria-hidden="true"
        ><svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
        ></span
      >
    </h3>
    <div class="flex flex-col gap-4">
      <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed">
        {description}
      </p>
    </div>
  </div>
</a>
