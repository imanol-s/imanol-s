---
import { getCollection } from "astro:content";
import SiteImage from "@/components/SiteImage.astro";
import { getSortedProjects } from "@/data/projectCollection";
import { getTechView } from "@/data/techRegistry";

const allProjects = getSortedProjects(await getCollection("projects"));
---

<section
  class="project-section scroll-mt-24 mb-28 render-deferred"
  id="projects"
  aria-labelledby="projects-heading"
>
  <h2 id="projects-heading" class="section-heading project-section-heading">
    Projects
  </h2>
  <div class="project-grid">
    {
      allProjects.map((project) => (
        <a
          href={`/projects/${project.id}`}
          class={`project-card project-${project.id} group cad-border focus-ring`}
        >
          <div class="project-artwork">
            <SiteImage
              src={project.data.cover}
              alt=""
              class="project-cover"
              sizes="(min-width: 1280px) 560px, (min-width: 768px) 45vw, 90vw"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="project-copy">
            <div
              class="project-tags font-display"
              aria-label="Selected technologies"
            >
              {project.data.tags.slice(0, 3).map((tag) => (
                <span>{getTechView(tag).displayName}</span>
              ))}
            </div>
            <h3 class="project-title font-display">{project.data.title}</h3>
            <p>{project.data.cardSummary ?? project.data.summary}</p>
            <span class="project-read font-display">
              Explore project <span aria-hidden="true">↗</span>
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .project-section-heading {
    margin-bottom: 2rem;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #fff;
    border-radius: 4px;
    color: #0f172a;
  }
  .project-artwork {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: #e8edf5;
    border-bottom: 1px solid #e2e8f0;
  }
  .project-artwork :global(.project-cover) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .project-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
    color: #475569;
    font-size: 0.75rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .project-title {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.035em;
    margin-bottom: 0.75rem;
  }
  .project-copy p {
    color: #475569;
    font-size: 0.9rem;
    line-height: 1.75;
    max-width: 46ch;
    margin-bottom: 1.5rem;
  }
  .project-read {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
    color: #334155;
    font-size: 0.75rem;
  }
  .project-read span {
    font-size: 1rem;
  }
  .project-card:hover {
    border-color: #94a3b8;
    background: #f8fafc;
  }
  .project-card:hover .project-read {
    color: #0f172a;
  }
  :global(.dark) .project-card {
    background: #111c2e;
    color: #f8fafc;
  }
  :global(.dark) .project-card:hover {
    background: #162338;
  }
  :global(.dark) .project-artwork {
    border-color: #334155;
  }
  :global(.dark) .project-copy p,
  :global(.dark) .project-tags {
    color: #cbd5e1;
  }
  :global(.dark) .project-read {
    border-color: #334155;
    color: #cbd5e1;
  }
  :global(.dark) .project-card:hover .project-read {
    color: #fff;
  }
  @media (prefers-reduced-motion: no-preference) {
    .project-artwork :global(.project-cover) {
      transition: transform 250ms ease;
    }
    .project-card:hover .project-artwork :global(.project-cover) {
      transform: scale(1.035);
    }
    .project-card,
    .project-read {
      transition:
        background-color 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease;
    }
  }
  @media (max-width: 767px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
    .project-copy {
      padding: 1.25rem;
    }
  }
</style>
