---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import { getSortedProjects } from "@/data/projectCollection";

const allProjects = getSortedProjects(await getCollection("projects"));
---

<section
  class="projects-section scroll-mt-20 render-deferred"
  id="projects"
  aria-label="Projects"
>
  <div
    class="flex items-end justify-between mb-8 border-b border-slate-200 dark:border-slate-800 pb-4"
  >
    <div>
      <h2 class="section-title font-body font-semibold">
        <span class="section-index" aria-hidden="true">01 /</span>PROJECTS
      </h2>
    </div>
  </div>
  <div id="projects-track" class="horizontal-scroll-snap">
    {
      allProjects.map((project, i) => (
        <a
          href={`/projects/${project.id}`}
          class="project-card group flex flex-col focus-ring"
        >
          <div class="project-image relative overflow-hidden">
            <Picture
              src={project.data.cover}
              alt={project.data.title}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
              formats={["avif"]}
              fallbackFormat="webp"
              widths={[360, 640, 960]}
              sizes="(min-width: 1024px) 600px, (min-width: 768px) 440px, 85vw"
            />
          </div>
          <div class="project-copy flex flex-col">
            <div class="exhibit-index" aria-hidden="true">
              <>
                <span>{String(i + 1).padStart(2, "0")}</span>
                <span class="exhibit-arrow">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                  >
                    <path d="M5 19 19 5M5 5h14v14" />
                  </svg>
                </span>
              </>
            </div>
            <h3 class="text-xl font-body font-semibold mb-3">
              {project.data.title}
            </h3>
            <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed">
              {project.data.summary}
            </p>
          </div>
        </a>
      ))
    }
  </div>

  <div class="flex justify-end gap-2 mt-4">
    <button
      id="carousel-prev"
      class="carousel-control cad-border px-3 py-1.5 font-display text-xs uppercase tracking-widest text-slate-500 hover:text-white transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
      aria-label="Previous projects"
    >
      ← PREV
    </button>
    <button
      id="carousel-next"
      class="carousel-control cad-border px-3 py-1.5 font-display text-xs uppercase tracking-widest text-slate-500 hover:text-white transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
      aria-label="Next projects"
    >
      NEXT →
    </button>
  </div>
</section>

<script>
  import { initCarousel } from "../utils/carousel";

  let cleanup: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    const track = document.getElementById("projects-track");
    const prev = document.getElementById(
      "carousel-prev",
    ) as HTMLButtonElement | null;
    const next = document.getElementById(
      "carousel-next",
    ) as HTMLButtonElement | null;
    if (track && prev && next) cleanup = initCarousel(track, prev, next);
  });
</script>
