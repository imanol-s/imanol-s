---
// Synthetic prototype data: one backend field shown under three front-end labels.
const systems = [
  { name: "System 1", label: "Label A" },
  { name: "System 2", label: "Label B" },
  { name: "System 3", label: "Label C" },
];
---

<figure class="conflict not-prose" aria-labelledby="conflict-caption">
  <ul class="conflict-readings" role="list">
    {
      systems.map((system) => (
        <li>
          <p class="conflict-team">{system.name} shows it as</p>
          <p class="conflict-label">{system.label}</p>
        </li>
      ))
    }
  </ul>
  <svg
    class="conflict-join"
    viewBox="0 0 300 40"
    preserveAspectRatio="none"
    aria-hidden="true"
    fill="none"
  >
    <path d="M50 0V14H250V0M150 0V40"></path>
  </svg>
  <p class="conflict-field">
    <span class="conflict-field-label">Stored as</span> Field A
  </p>
  <figcaption id="conflict-caption">
    One stored field, three labels. Names are generic stand-ins; the real system
    and field names are withheld.
  </figcaption>
</figure>

<style>
  .conflict {
    margin: 2rem 0;
  }
  .conflict .conflict-readings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .conflict .conflict-readings li {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--story-border, #334155);
    border-radius: 3px;
    background: var(--story-panel, #111c2e);
  }
  .conflict-team {
    margin: 0 0 0.35rem;
    font-size: 0.8125rem;
    color: #94a3b8;
  }
  .conflict .conflict-label {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--story-heading, #f1f5f9);
  }
  .conflict-join {
    display: block;
    width: 100%;
    height: 2rem;
    stroke: #64748b;
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }
  .conflict-join path {
    vector-effect: non-scaling-stroke;
  }
  .conflict .conflict-field {
    display: block;
    width: fit-content;
    margin: 0 auto;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--story-mint, #b6e5d3);
    border-radius: 3px;
    font-size: 0.9375rem;
    color: var(--story-mint, #b6e5d3);
  }
  .conflict-field-label {
    margin-right: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: #94a3b8;
  }
  .conflict figcaption {
    margin-top: 1rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: #94a3b8;
  }
  /* Phones keep the three systems side by side as compact chips. */
  @media (max-width: 639px) {
    .conflict .conflict-readings {
      gap: 0.375rem;
    }
    .conflict .conflict-readings li {
      padding: 0.6rem 0.5rem;
    }
    .conflict-team {
      font-size: 0.75rem;
    }
    .conflict .conflict-label {
      font-size: 0.9375rem;
    }
  }
</style>
