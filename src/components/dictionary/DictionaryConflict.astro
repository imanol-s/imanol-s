---
import Redacted from "./Redacted.astro";

// Synthetic prototype data: one backend field shown under three front-end labels.
const systems = ["System 1", "System 2", "System 3"];
---

<figure class="conflict not-prose" aria-labelledby="conflict-caption">
  <ul class="conflict-readings" role="list">
    {
      systems.map((system) => (
        <li>
          <p class="conflict-team">{system} shows it as</p>
          <Redacted kind="label" length={12} />
        </li>
      ))
    }
  </ul>
  <svg
    class="conflict-join"
    viewBox="0 0 300 40"
    preserveAspectRatio="none"
    aria-hidden="true"
    fill="none"
  >
    <path d="M50 0V14H250V0M150 0V40"></path>
  </svg>
  <p class="conflict-field">
    <span class="conflict-field-label">backend</span> FIELD_A
  </p>
  <figcaption id="conflict-caption">
    Synthetic example. One stored field, three labels. Each bar marks where a
    real label would sit.
  </figcaption>
</figure>

<style>
  .conflict {
    margin: 2rem 0;
  }
  .conflict .conflict-readings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .conflict .conflict-readings li {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--story-border, #334155);
    border-radius: 3px;
    background: var(--story-panel, #111c2e);
  }
  .conflict-team {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #94a3b8;
  }
  .conflict-join {
    display: block;
    width: 100%;
    height: 2rem;
    stroke: #64748b;
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }
  .conflict-join path {
    vector-effect: non-scaling-stroke;
  }
  .conflict .conflict-field {
    display: block;
    width: fit-content;
    margin: 0 auto;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--story-mint, #b6e5d3);
    border-radius: 3px;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--story-mint, #b6e5d3);
  }
  .conflict-field-label {
    margin-right: 0.4rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #94a3b8;
  }
  .conflict figcaption {
    margin-top: 1rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: #94a3b8;
  }
  /* Phones keep the three systems side by side as compact chips. */
  @media (max-width: 639px) {
    .conflict .conflict-readings {
      gap: 0.375rem;
    }
    .conflict .conflict-readings li {
      padding: 0.6rem 0.5rem;
    }
    .conflict-team {
      font-size: 0.625rem;
      letter-spacing: 0.02em;
    }
  }
</style>
