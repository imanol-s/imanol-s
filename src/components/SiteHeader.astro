---
import { Icon } from "astro-icon/components";
import { ME, SITE } from "../config";

const resumeHref = `/${ME.contactInfo.resumeDoc}`;
---

<header
  class="site-header"
>
  <nav
    class="site-nav flex items-center justify-between"
    aria-label="Site navigation"
  >
    <a
      href="/"
      class="site-brand flex items-center space-x-2 font-body font-semibold text-lg tracking-tighter focus-ring rounded-sm"
      aria-label={`Home — ${ME.name}`}
    >
      <Icon
        name={SITE.logo}
        class="brand-frog"
        data-brand-frog
        aria-hidden="true"
      />
      <span>{SITE.logoText.toUpperCase()}</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center space-x-8 font-display text-sm">
      <a
        class="drawing-hover text-accent hover:text-white transition-colors focus-ring rounded-sm"
        href="/projects"
      >
        PROJECTS
      </a>
      <a
        class="header-resume focus-ring"
        href={resumeHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        RESUME
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
            points="7 10 12 15 17 10"></polyline><line
            x1="12"
            y1="15"
            x2="12"
            y2="3"></line></svg
        >
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-slate-500 hover:text-primary focus-ring rounded-sm"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="4" y1="12" x2="20" y2="12"></line><line
          x1="4"
          y1="6"
          x2="20"
          y2="6"></line><line x1="4" y1="18" x2="20" y2="18"></line></svg
      >
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden header-menu"
  >
    <div class="flex flex-col px-6 py-4 space-y-4 font-display text-sm">
      <a
        class="text-accent hover:text-white transition-colors focus-ring rounded-sm"
        href="/projects">PROJECTS</a
      >
      <a
        class="header-resume focus-ring w-fit"
        href={resumeHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        RESUME
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
            points="7 10 12 15 17 10"></polyline><line
            x1="12"
            y1="15"
            x2="12"
            y2="3"></line></svg
        >
      </a>
    </div>
  </div>
</header>
<div
  id="scroll-frog"
  data-scroll-frog
  class="scroll-frog"
  aria-hidden="true"
  hidden
>
  <Icon name={SITE.logo} />
</div>

<script is:inline>
  document.getElementById("mobile-menu")?.classList.add("hidden");
</script>

<script>
  import { initMobileMenu } from "../utils/mobileMenu";
  import { initHeaderScroll } from "../utils/headerScroll";
  import { initFrogScroll } from "../utils/frogScroll";

  let cleanup: (() => void) | undefined;
  document.addEventListener("astro:before-swap", () => cleanup?.());
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    const header = document.querySelector<HTMLElement>(".site-header");
    const logo = header?.querySelector<SVGElement>(".brand-frog");
    const frog = document.getElementById("scroll-frog");
    const btn = document.getElementById(
      "mobile-menu-btn",
    ) as HTMLButtonElement | null;
    const menu = document.getElementById("mobile-menu");
    const disposeMenu = btn && menu ? initMobileMenu(btn, menu) : undefined;
    const disposeFrog =
      header && logo && frog
        ? initFrogScroll({ header, logo, frog, menuButton: btn })
        : undefined;
    const disposeHeader = header ? initHeaderScroll(header, btn) : undefined;
    cleanup = () => {
      disposeHeader?.();
      disposeMenu?.();
      disposeFrog?.();
    };
  });
</script>
