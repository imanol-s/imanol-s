<figure class="training-loop" aria-labelledby="training-loop-caption">
  <figcaption id="training-loop-caption">Conceptual training loop</figcaption>
  <div class="loop-cycle">
    <svg
      class="loop-definitions"
      width="1"
      height="1"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <marker
          id="training-loop-arrow"
          markerWidth="8"
          markerHeight="10"
          refX="0"
          refY="0"
          markerUnits="userSpaceOnUse"
          orient="auto"
          overflow="visible"
        >
          <path d="M -5 -4 L 0 0 L -5 4"></path>
        </marker>
      </defs>
    </svg>
    <ol class="loop-steps">
      <li class="observe">
        Observe<svg
          class="loop-forward"
          height="12"
          aria-hidden="true"
          focusable="false"
          ><line
            x1="0"
            y1="50%"
            x2="100%"
            y2="50%"
            marker-end="url(#training-loop-arrow)"></line></svg
        >
      </li>
      <li class="choose">
        Choose<br />action<svg
          class="loop-forward"
          height="12"
          aria-hidden="true"
          focusable="false"
          ><line
            x1="0"
            y1="50%"
            x2="100%"
            y2="50%"
            marker-end="url(#training-loop-arrow)"></line></svg
        >
      </li>
      <li class="response">
        Simulated<br />response<svg
          class="loop-forward"
          height="12"
          aria-hidden="true"
          focusable="false"
          ><line
            x1="0"
            y1="50%"
            x2="100%"
            y2="50%"
            marker-end="url(#training-loop-arrow)"></line></svg
        >
      </li>
      <li class="reward">
        Reward/end<br />condition<svg
          class="loop-forward"
          height="12"
          aria-hidden="true"
          focusable="false"
          ><line
            x1="0"
            y1="50%"
            x2="100%"
            y2="50%"
            marker-end="url(#training-loop-arrow)"></line></svg
        >
      </li>
      <li class="reset">Continue<br />or reset</li>
    </ol>
    <div
      role="img"
      aria-label="After continuing or resetting, repeat from Observe."
    >
      <svg
        class="loop-return loop-return-horizontal"
        aria-hidden="true"
        focusable="false"
      >
        <line x1="100%" y1="0" x2="100%" y2="100%"></line>
        <line x1="100%" y1="100%" x2="0" y2="100%"></line>
        <line
          x1="0"
          y1="100%"
          x2="0"
          y2="0"
          marker-end="url(#training-loop-arrow)"></line>
      </svg>
      <svg
        class="loop-return loop-return-vertical"
        aria-hidden="true"
        focusable="false"
      >
        <line x1="100%" y1="100%" x2="0" y2="100%"></line>
        <line x1="0" y1="100%" x2="0" y2="0"></line>
        <line
          x1="0"
          y1="0"
          x2="100%"
          y2="0"
          marker-end="url(#training-loop-arrow)"></line>
      </svg>
    </div>
  </div>
</figure>

<style>
  .training-loop {
    --loop-gap: 1rem;
    --loop-ink: #d3c3f3;
    --loop-gap-mobile: 1.5rem;
    --loop-indent: 2rem;
    container-type: inline-size;
    min-width: 0;
    margin: 0;
    padding-bottom: 2rem;
  }
  figcaption {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .loop-cycle {
    position: relative;
  }
  .training-loop .loop-steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--loop-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .training-loop .loop-steps li {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 4rem;
    margin: 0;
    padding: 0.5rem 0.1875rem;
    border-radius: 4px;
    font-size: 0.75rem;
    line-height: 1.4;
    color: #081828;
    text-align: center;
  }
  .observe,
  .reset {
    background: #c9e9f7;
  }
  .choose {
    background: #c3eac8;
  }
  .response {
    background: #f7e6af;
  }
  .reward {
    background: #d3c3f3;
  }
  .loop-definitions,
  .loop-forward,
  .loop-return {
    position: absolute;
    z-index: 1;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: var(--loop-ink);
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .loop-definitions {
    left: 0;
    top: 0;
  }
  .loop-forward {
    left: 100%;
    top: 50%;
    width: var(--loop-gap);
    height: 12px;
    transform: translateY(-50%);
  }
  .loop-return-horizontal {
    left: calc((100% - 4 * var(--loop-gap)) / 10);
    right: calc((100% - 4 * var(--loop-gap)) / 10);
    top: 100%;
    width: calc(100% - (100% - 4 * var(--loop-gap)) / 5);
    height: 24px;
  }
  .loop-return-vertical {
    display: none;
  }
  @container (max-width: 25rem) {
    .training-loop .loop-steps {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 1fr;
      gap: var(--loop-gap-mobile);
      width: calc(100% - var(--loop-indent));
      margin-left: var(--loop-indent);
    }
    .loop-forward {
      left: 50%;
      top: calc(100% - 6px);
      width: var(--loop-gap-mobile);
      transform: rotate(90deg);
      transform-origin: 0 50%;
    }
    .loop-return-horizontal {
      display: none;
    }
    .loop-return-vertical {
      display: block;
      left: 0;
      top: calc((100% - 4 * var(--loop-gap-mobile)) / 10);
      width: var(--loop-indent);
      height: calc(100% - (100% - 4 * var(--loop-gap-mobile)) / 5);
    }
    .training-loop {
      padding-bottom: 0;
    }
  }
</style>
