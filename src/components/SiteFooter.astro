---
import { ME, SITE, SOCIALS } from "../config";
---

<footer id="contact" class="site-footer">
  <div class="footer-inner max-w-7xl mx-auto px-6">
    <div class="footer-contact">
      <div>
        <h2 class="section-heading">Get in touch</h2>
        <p class="section-intro">{ME.contactNote}</p>
      </div>
      <div class="footer-links">
        <a
          class="contact-email focus-ring"
          href={`mailto:${ME.contactInfo.email}`}
          >{ME.contactInfo.email}<span aria-hidden="true">↗</span></a
        >
        <div class="footer-socials">
          {
            SOCIALS.filter((social) => social.show).map((social) => (
              <a
                class="text-link focus-ring"
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {social.name}
                <span aria-hidden="true">↗</span>
              </a>
            ))
          }<a
            class="text-link focus-ring"
            href={`/${ME.contactInfo.resumeDoc}`}
            target="_blank"
            rel="noopener noreferrer">Résumé<span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {SITE.author}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 10;
    border-top: 1px solid #334155;
    background: #101a2b;
  }
  .footer-inner {
    padding-top: 3.75rem;
    padding-bottom: 2rem;
  }
  .footer-contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
    padding-bottom: 3rem;
  }
  .section-heading {
    margin: 0 0 1rem;
  }
  .section-intro {
    max-width: 27rem;
  }
  .footer-links {
    justify-self: end;
    max-width: 100%;
  }
  .contact-email {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 1.6vw, 1.25rem);
    color: #d7f5e9;
    min-height: 3.5rem;
    border-bottom: 1px solid #475569;
  }
  .contact-email:hover {
    color: #fff;
  }
  .footer-socials {
    display: flex;
    gap: 1.8rem;
    padding-top: 0.7rem;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.2rem;
    border-top: 1px solid #334155;
    padding-top: 1.5rem;
    font-family: var(--font-display);
    font-size: 0.65rem;
    color: #94a3b8;
    line-height: 1.7;
  }
  @media (max-width: 767px) {
    .footer-contact {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .footer-links {
      justify-self: stretch;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
