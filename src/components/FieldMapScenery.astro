---
import { getImage } from "astro:assets";
import terrain from "../assets/field-map-terrain.webp";

const terrainImage = await getImage({ src: terrain, format: "webp" });
const leftContour = [1, 0.84, 0.66, 0.5, 0.31];
const rightContour = [1, 0.78, 0.6, 0.36];
// Tarn shoreline in lake-box units, blurred so the edge reads like the terrain's wash.
const lakeMask = `url("data:image/svg+xml,${encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 185 58"><filter id="b"><feGaussianBlur stdDeviation="8"/></filter><path filter="url(#b)" d="M12 10L60 8L120 9L173 8C176 20 164 31 141 40C113 48 76 49 47 44C25 40 10 29 12 10Z"/></svg>',
)}")`;
---

<div class="field-map-scenery" aria-hidden="true">
  <div class="field-map-clouds">
    <span></span>
    <span></span>
  </div>
  <img
    class="field-map-terrain"
    src={terrainImage.src}
    width={terrain.width}
    height={terrain.height}
    alt=""
    loading="eager"
    decoding="async"
    fetchpriority="low"
  />
  <div class="field-map-lake">
    <div
      class="field-map-tarn"
      style={`--terrain: url(${terrainImage.src}); --lake-mask: ${lakeMask}`}
    >
      <span class="lake-reflection"></span>
      <span class="lake-water"></span>
    </div>
  </div>
  <svg class="field-map-contour contour-left" viewBox="-100 -100 200 200">
    <defs>
      <path
        id="field-map-contour-left"
        d="M0-88C38-90 82-62 86-18C90 30 60 80 8 86C-40 92-84 58-88 10C-92-40-46-86 0-88Z"
        vector-effect="non-scaling-stroke"></path>
    </defs>
    {
      leftContour.map((scale) => (
        <use href="#field-map-contour-left" transform={`scale(${scale})`} />
      ))
    }
  </svg>
  <svg class="field-map-contour contour-right" viewBox="-100 -100 200 200">
    <defs>
      <path
        id="field-map-contour-right"
        d="M-6-80C40-84 92-40 84 8C76 56 34 92-14 84C-60 76-90 34-84-12C-78-56-50-76-6-80Z"
        vector-effect="non-scaling-stroke"></path>
    </defs>
    {
      rightContour.map((scale) => (
        <use href="#field-map-contour-right" transform={`scale(${scale})`} />
      ))
    }
  </svg>
  <svg class="field-map-trail">
    <defs>
      <mask id="field-map-trail-reveal" maskUnits="userSpaceOnUse">
        <path id="field-map-trail-ink" vector-effect="non-scaling-stroke"
        ></path>
      </mask>
    </defs>
    <!-- initTrailInk adds the reveal mask, so the trail stays whole without JS. -->
    <path id="field-map-trail-path" vector-effect="non-scaling-stroke"></path>
  </svg>
</div>

<style>
  .field-map-scenery {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
    pointer-events: none;
  }
  .field-map-terrain {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0.24;
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  /* Cloud shadows drift over the terrain; they share its size and fade. */
  .field-map-clouds {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    aspect-ratio: 1024 / 1536;
    overflow: clip;
    mask-image: linear-gradient(to bottom, #000 45%, transparent 60%);
  }
  .field-map-clouds span {
    position: absolute;
    top: 6%;
    left: 0;
    width: 55%;
    height: 16%;
    background: radial-gradient(closest-side, rgb(2 6 23 / 55%), transparent);
    animation: field-map-cloud 90s linear -40s infinite;
  }
  .field-map-clouds span + span {
    top: 22%;
    width: 42%;
    height: 12%;
    animation-duration: 120s;
    animation-delay: -95s;
  }
  @keyframes field-map-cloud {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(240%);
    }
  }
  /* .forest-scene[data-paused] (ForestScene.astro) covers the pause button, offscreen hero and hidden tabs. */
  :global(body:has(.forest-scene[data-paused="true"])) .field-map-clouds span {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .field-map-clouds span {
      animation: none;
      transform: translateX(60%);
    }
  }
  /*
   * Alpine tarn in the saddle at terrain (455, 360), 185 x 58 image px, above the middle hill's crest.
   * It reuses the terrain file: the painted water from the bottom of the artwork, plus the slope above
   * the lake mirrored into it. Background positions are src / (artwork size - lake size).
   */
  .field-map-lake {
    position: absolute;
    inset: 0 0 auto;
    aspect-ratio: 1024 / 1536;
  }
  .field-map-tarn {
    position: absolute;
    left: calc(455 / 1024 * 100%);
    top: calc(360 / 1536 * 100%);
    width: calc(185 / 1024 * 100%);
    aspect-ratio: 185 / 58;
    opacity: 0.3;
    mask: var(--lake-mask) center / 100% 100% no-repeat;
  }
  .field-map-tarn span {
    position: absolute;
    inset: 0;
    background-image: var(--terrain);
    background-repeat: no-repeat;
    background-size: calc(1024 / 185 * 100%) auto;
  }
  .field-map-tarn .lake-water {
    background-position: calc(705 / 839 * 100%) calc(1394 / 1478 * 100%);
    opacity: 0.85;
  }
  .field-map-tarn .lake-reflection {
    background-position: calc(455 / 839 * 100%) calc(302 / 1478 * 100%);
    transform: scaleY(-1);
  }
  /* The terrain scales with the viewport but the hero does not: below 1200px the intro text covers
     the saddle, and from 1540px the saddle drops into the stats row. */
  @media (max-width: 1199px), (min-width: 1540px) {
    .field-map-lake {
      display: none;
    }
  }
  #field-map-trail-ink {
    fill: none;
    stroke: #fff;
    stroke-width: 12;
    stroke-linecap: round;
  }
  .field-map-contour {
    position: absolute;
    width: 18rem;
    height: 18rem;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: 0.16;
  }
  .contour-left {
    top: 42%;
    right: calc(50% + 41rem);
  }
  .contour-right {
    top: 70%;
    left: calc(50% + 41rem);
  }
  .field-map-trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--color-soft-mint);
    stroke-width: 1;
    stroke-dasharray: 4 8;
    opacity: 0.32;
  }
  @media (max-width: 1399px) {
    .field-map-contour {
      display: none;
    }
  }
</style>

<script>
  import { initFieldMapTrail, initTrailInk } from "@/utils/fieldMapTrail";

  let cleanup: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    cleanup = undefined;
    const path = document.getElementById(
      "field-map-trail-path",
    ) as SVGPathElement | null;
    const ink = document.getElementById(
      "field-map-trail-ink",
    ) as SVGPathElement | null;
    if (!path || !ink) return;
    const stopTrail = initFieldMapTrail(path);
    const stopInk = initTrailInk(path, ink);
    cleanup = () => {
      stopTrail();
      stopInk();
    };
  });
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
