---
import { getImage } from "astro:assets";
import terrain from "../assets/field-map-terrain.webp";

const terrainImage = await getImage({ src: terrain, format: "webp" });
const leftContour = [1, 0.84, 0.66, 0.5, 0.31];
const rightContour = [1, 0.78, 0.6, 0.36];
// Lake outline in terrain pixels: far shore along the upper hills, near shore a smooth curve along the crests that hide it.
const farShore =
  "M176 432L196 414L225 400L260 392L300 388L350 386L400 388L440 392L480 398L520 402L560 405L600 404L640 408L680 413L720 418L760 423L800 428L840 434L880 441L910 452C928 464 945 498 952 543";
const nearShore =
  "C948.8 542.3 947.2 542.8 933 539C918.8 535.2 889.2 525.5 867 520C844.8 514.5 822.3 512.2 800 506C777.7 499.8 751.8 490.7 733 483C714.2 475.3 701.3 467.2 687 460C672.7 452.8 661.5 445.3 647 440C632.5 434.7 615.7 430.3 600 428C584.3 425.7 567.5 427 553 426C538.5 425 526.3 421.3 513 422C499.7 422.7 486.3 426.3 473 430C459.7 433.7 447.3 439.3 433 444C418.7 448.7 409.2 457 387 458C364.8 459 325.7 453 300 450C274.3 447 253.7 443 233 440C212.3 437 185.5 433.3 176 432";
const lakeShore = `${farShore}${nearShore}Z`;
---

<div class="field-map-scenery" aria-hidden="true">
  <div class="field-map-clouds">
    <span></span>
    <span></span>
  </div>
  <img
    class="field-map-terrain"
    src={terrainImage.src}
    width={terrain.width}
    height={terrain.height}
    alt=""
    loading="eager"
    decoding="async"
    fetchpriority="low"
  />
  <div class="field-map-additions">
    <svg viewBox="0 0 1024 1536" preserveAspectRatio="none">
      <defs>
        <filter id="field-map-lake-rim-soft">
          <feGaussianBlur stdDeviation="0.8"></feGaussianBlur>
        </filter>
        <filter id="field-map-soft-edge">
          <feGaussianBlur stdDeviation="5"></feGaussianBlur>
        </filter>
        <linearGradient
          id="field-map-range-haze"
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="190"
          x2="0"
          y2="300"
        >
          <stop offset="0" stop-color="#fff"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
        </linearGradient>
        <linearGradient
          id="field-map-range-west"
          gradientUnits="userSpaceOnUse"
          x1="250"
          y1="0"
          x2="330"
          y2="0"
        >
          <stop offset="0"></stop>
          <stop offset="1" stop-opacity="0"></stop>
        </linearGradient>
        <!-- Sky above the existing range's west slope, so the new peaks sit behind it and fade into haze. -->
        <mask
          id="field-map-range-sky"
          maskUnits="userSpaceOnUse"
          x="0"
          y="0"
          width="1024"
          height="1536"
        >
          <path
            d="M0 0H630L600 166L575 178L545 186L520 195L490 213L460 228L430 245L380 268L300 310L0 310Z"
            fill="url(#field-map-range-haze)"
            filter="url(#field-map-soft-edge)"></path>
          <rect width="1024" height="320" fill="url(#field-map-range-west)"
          ></rect>
        </mask>
        <clipPath id="field-map-range-peaks">
          <path
            d="M560 204L600 187L640 162L690 122L720 88L745 110L770 138L800 130L840 95L880 66L910 90L960 110L1024 125V340H560Z"
          ></path>
        </clipPath>
        <linearGradient
          id="field-map-ridge-fade"
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="560"
          x2="0"
          y2="640"
        >
          <stop offset="0" stop-color="#fff"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
        </linearGradient>
        <!-- In the terrain's own pixels: the hump's crest, its west end cut down into the valley. -->
        <mask
          id="field-map-ridge"
          maskUnits="userSpaceOnUse"
          x="0"
          y="0"
          width="1024"
          height="1536"
        >
          <path
            d="M165 640L172 560L195 480L233 430L387 444L433 429L473 415L513 407L553 411L600 413L647 425L687 445L733 469L800 492L867 505L933 525L1024 552V640Z"
            fill="url(#field-map-ridge-fade)"
            filter="url(#field-map-soft-edge)"></path>
        </mask>
        <filter
          id="field-map-lake-brush"
          x="-5%"
          y="-30%"
          width="110%"
          height="160%"
        >
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.02 0.14"
            numOctaves="2"
            seed="7"></feTurbulence>
          <feDisplacementMap
            in="SourceGraphic"
            scale="4"
            xChannelSelector="R"
            yChannelSelector="G"></feDisplacementMap>
          <feGaussianBlur stdDeviation="1.2"></feGaussianBlur>
        </filter>
        <filter
          id="field-map-lake-fade"
          x="-10%"
          y="-50%"
          width="120%"
          height="200%"
        >
          <feGaussianBlur stdDeviation="9"></feGaussianBlur>
        </filter>
        <!-- Horizontal strokes in the artwork's water blues, stepped like its flat paint. -->
        <filter
          id="field-map-lake-paint"
          x="0"
          y="0"
          width="100%"
          height="100%"
          color-interpolation-filters="sRGB"
        >
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.005 0.08"
            numOctaves="3"
            seed="2"></feTurbulence>
          <feComponentTransfer>
            <feFuncR type="discrete" tableValues="0 0.2 0.45 0.7 1"></feFuncR>
          </feComponentTransfer>
          <feColorMatrix
            values="0.54 0 0 0 0.3 0.45 0 0 0 0.52 0.31 0 0 0 0.75 0 0 0 0 1"
          ></feColorMatrix>
        </filter>
        <!-- Bounded to the lake: over the whole terrain it costs ~60ms a frame on CPU rendering. -->
        <filter
          id="field-map-lake-ripple"
          filterUnits="userSpaceOnUse"
          x="150"
          y="370"
          width="830"
          height="200"
        >
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.006 0.18"
            numOctaves="2"
            seed="4"></feTurbulence>
          <feDisplacementMap
            in="SourceGraphic"
            scale="7"
            xChannelSelector="R"
            yChannelSelector="G"></feDisplacementMap>
        </filter>
        <mask
          id="field-map-lake-water"
          maskUnits="userSpaceOnUse"
          x="0"
          y="0"
          width="1024"
          height="1536"
        >
          <path
            class="lake-shore"
            d={lakeShore}
            fill="#fff"
            filter="url(#field-map-lake-brush)"></path>
        </mask>
        <!-- Open water catches the light; the band under the far shore holds the hills' dark reflection. -->
        <mask
          id="field-map-lake-sheen"
          maskUnits="userSpaceOnUse"
          x="0"
          y="0"
          width="1024"
          height="1536"
        >
          <path
            d={lakeShore}
            fill="#fff"
            transform="translate(0 22)"
            filter="url(#field-map-lake-fade)"></path>
        </mask>
        <clipPath id="field-map-lake-west"
          ><rect width="540" height="1536"></rect></clipPath
        >
        <clipPath id="field-map-lake-east"
          ><rect x="540" width="484" height="1536"></rect></clipPath
        >
      </defs>
      <!-- A smaller, lower copy of the summits, further away to the west. -->
      <g mask="url(#field-map-range-sky)">
        <image
          href={terrainImage.src}
          width="1024"
          height="1536"
          clip-path="url(#field-map-range-peaks)"
          transform="translate(-234 109) scale(0.8 0.62)"
          opacity="0.2"
        />
      </g>
      <g class="field-map-lake">
        <g mask="url(#field-map-lake-water)">
          <rect x="150" y="380" width="830" height="180" fill="#0f172a"></rect>
          <g mask="url(#field-map-lake-sheen)">
            <rect
              x="150"
              y="380"
              width="830"
              height="180"
              filter="url(#field-map-lake-paint)"
              opacity="0.44"></rect>
          </g>
          <!-- Terrain mirrored about each arm's far shore (y' = 2(a + mx) - y). -->
          <g filter="url(#field-map-lake-ripple)" opacity="0.22">
            <image
              href={terrainImage.src}
              width="1024"
              height="1536"
              clip-path="url(#field-map-lake-west)"
              transform="matrix(1 0.054 0 -1 0 770)"
            />
            <image
              href={terrainImage.src}
              width="1024"
              height="1536"
              clip-path="url(#field-map-lake-east)"
              transform="matrix(1 0.293 0 -1 0 645.4)"
            />
          </g>
        </g>
        <!-- Light catching the near shore, so the waterline reads cleanly against the crests. -->
        <path
          d={`M952 543${nearShore}`}
          fill="none"
          stroke="#b9cde6"
          stroke-width="2.5"
          stroke-linecap="round"
          opacity="0.15"
          filter="url(#field-map-lake-rim-soft)"></path>
      </g>
      <!-- A nearer ridge below the lake: the hump mirrored and enlarged, painted over the slope it covers. -->
      <g
        transform="matrix(-1.1 0 0 1.1 864.3 72.5)"
        mask="url(#field-map-ridge)"
      >
        <rect x="160" y="395" width="864" height="245" fill="#0f172a"></rect>
        <image
          href={terrainImage.src}
          width="1024"
          height="1536"
          opacity="0.24"
        />
      </g>
    </svg>
  </div>
  <svg class="field-map-contour contour-left" viewBox="-100 -100 200 200">
    <defs>
      <path
        id="field-map-contour-left"
        d="M0-88C38-90 82-62 86-18C90 30 60 80 8 86C-40 92-84 58-88 10C-92-40-46-86 0-88Z"
        vector-effect="non-scaling-stroke"></path>
    </defs>
    {
      leftContour.map((scale) => (
        <use href="#field-map-contour-left" transform={`scale(${scale})`} />
      ))
    }
  </svg>
  <svg class="field-map-contour contour-right" viewBox="-100 -100 200 200">
    <defs>
      <path
        id="field-map-contour-right"
        d="M-6-80C40-84 92-40 84 8C76 56 34 92-14 84C-60 76-90 34-84-12C-78-56-50-76-6-80Z"
        vector-effect="non-scaling-stroke"></path>
    </defs>
    {
      rightContour.map((scale) => (
        <use href="#field-map-contour-right" transform={`scale(${scale})`} />
      ))
    }
  </svg>
  <svg class="field-map-trail">
    <defs>
      <mask id="field-map-trail-reveal" maskUnits="userSpaceOnUse">
        <path id="field-map-trail-ink" vector-effect="non-scaling-stroke"
        ></path>
      </mask>
    </defs>
    <!-- initTrailInk adds the reveal mask, so the trail stays whole without JS. -->
    <path id="field-map-trail-path" vector-effect="non-scaling-stroke"></path>
  </svg>
</div>

<style>
  .field-map-scenery {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
    pointer-events: none;
  }
  .field-map-terrain {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0.24;
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  /* Cloud shadows drift over the terrain; they share its size and fade. */
  .field-map-clouds {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    aspect-ratio: 1024 / 1536;
    overflow: clip;
    mask-image: linear-gradient(to bottom, #000 45%, transparent 60%);
  }
  .field-map-clouds span {
    position: absolute;
    top: 6%;
    left: 0;
    width: 55%;
    height: 16%;
    background: radial-gradient(closest-side, rgb(2 6 23 / 55%), transparent);
    animation: field-map-cloud 90s linear -40s infinite;
  }
  .field-map-clouds span + span {
    top: 22%;
    width: 42%;
    height: 12%;
    animation-duration: 120s;
    animation-delay: -95s;
  }
  @keyframes field-map-cloud {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(240%);
    }
  }
  /* .forest-scene[data-paused] (ForestScene.astro) covers the pause button, offscreen hero and hidden tabs. */
  :global(body:has(.forest-scene[data-paused="true"])) .field-map-clouds span {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .field-map-clouds span {
      animation: none;
      transform: translateX(60%);
    }
  }
  /* The additions share the terrain's size, so they stay in place on it. The hero does not scale with it:
     below 1200px the lake reaches the portrait, and from 1625px it runs into the trail and project cards. */
  .field-map-additions {
    position: absolute;
    inset: 0 0 auto;
    aspect-ratio: 1024 / 1536;
  }
  .field-map-additions svg {
    width: 100%;
    height: 100%;
  }
  @media (max-width: 1199px), (min-width: 1625px) {
    .field-map-lake {
      display: none;
    }
  }
  #field-map-trail-ink {
    fill: none;
    stroke: #fff;
    stroke-width: 12;
    stroke-linecap: round;
  }
  .field-map-contour {
    position: absolute;
    width: 18rem;
    height: 18rem;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: 0.16;
  }
  .contour-left {
    top: 42%;
    right: calc(50% + 41rem);
  }
  .contour-right {
    top: 70%;
    left: calc(50% + 41rem);
  }
  .field-map-trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--color-soft-mint);
    stroke-width: 1;
    stroke-dasharray: 4 8;
    opacity: 0.32;
  }
  @media (max-width: 1399px) {
    .field-map-contour {
      display: none;
    }
  }
</style>

<script>
  import { initFieldMapTrail, initTrailInk } from "@/utils/fieldMapTrail";

  let cleanup: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    cleanup = undefined;
    const path = document.getElementById(
      "field-map-trail-path",
    ) as SVGPathElement | null;
    const ink = document.getElementById(
      "field-map-trail-ink",
    ) as SVGPathElement | null;
    if (!path || !ink) return;
    const stopTrail = initFieldMapTrail(path);
    const stopInk = initTrailInk(path, ink);
    cleanup = () => {
      stopTrail();
      stopInk();
    };
  });
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
