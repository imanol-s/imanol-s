---
import { jobStartDate, jobEndDate, timelineJobs } from "../data/career";
import { formatDate } from "../utils/formatDate";
const jobs = timelineJobs();
---

<section
  id="experience"
  class="experience-section scroll-mt-28"
  aria-labelledby="experience-heading"
>
  <div class="experience-heading">
    <h2 id="experience-heading" class="section-heading">Experience</h2>
  </div>
  <div class="career-timeline">
    {
      jobs.map((job) => {
        const start = jobStartDate(job);
        const end = jobEndDate(job);
        return (
          <article
            class:list={["career-entry", { "current-entry": job.currentJob }]}
          >
            <div class="timeline-point" aria-hidden="true" />
            <div class="career-entry-top">
              <p class="career-dates">
                {start ? formatDate(start) : ""} <span>to</span>{" "}
                {job.currentJob ? "Present" : end ? formatDate(end) : ""}
              </p>
              {job.currentJob && (
                <span class="current-label">
                  <span class="signal-dot" aria-hidden="true" />
                  Current role
                </span>
              )}
            </div>
            <>
              <h3>{job.title}</h3>
              <p class="career-company">
                {job.company}
                <span aria-hidden="true"> / </span>
                {job.location}
              </p>
            </>
            <p class="career-description">{job.description}</p>
            {job.goals.length > 0 && (
              <ul class="career-highlights">
                {job.goals.map((goal) => (
                  <li>
                    <svg
                      class="highlight-arrow"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M7 17L17 7M7 7H17V17"
                        stroke="currentColor"
                        stroke-width="1.5"
                      />
                    </svg>
                    <span>{goal}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .experience-section {
    margin-bottom: 3rem;
  }
  .experience-heading {
    margin-bottom: 1.75rem;
  }
  .section-heading {
    font-size: clamp(1.5rem, 2.3vw, 2rem);
  }
  .career-timeline {
    padding-left: 1.25rem;
  }
  .career-entry {
    position: relative;
    border-left: 1px solid #334155;
    padding: 0.1rem 0 2rem 1.5rem;
  }
  .career-entry:last-child {
    padding-bottom: 0.25rem;
  }
  .timeline-point {
    position: absolute;
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid #64748b;
    background: #0f172a;
    border-radius: 50%;
    top: 0.35rem;
    left: -0.35rem;
    box-shadow: 0 0 0 6px #0f172a;
  }
  .current-entry .timeline-point {
    background: #b6e5d3;
    border-color: #b6e5d3;
  }
  .career-entry-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }
  .career-dates {
    color: #a6b5c8;
    font-family: var(--font-display);
    font-size: 0.65rem;
  }
  .career-dates span {
    padding: 0 0.25rem;
  }
  .current-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #b6e5d3;
    background: #b6e5d30c;
    border: 1px solid #b6e5d330;
    padding: 0.35rem 0.65rem;
    border-radius: 3px;
    font-family: var(--font-display);
    font-size: 0.6rem;
  }
  .career-entry h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.5;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .career-company {
    color: #a6b5c8;
    font-size: 0.8rem;
    margin: 0.35rem 0 1rem;
  }
  .career-company span {
    color: #64748b;
    margin: 0 0.25rem;
  }
  .career-description {
    color: #cbd5e1;
    font-size: 0.9rem;
    line-height: 1.85;
  }
  .career-highlights {
    margin-top: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .career-highlights li {
    display: flex;
    gap: 0.8rem;
    font-size: 0.85rem;
    line-height: 1.75;
    color: #cbd5e1;
  }
  .career-highlights li > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .highlight-arrow {
    flex-shrink: 0;
    color: #b6e5d3;
    margin-top: 0.3rem;
  }
  @media (max-width: 767px) {
    .career-timeline {
      padding-left: 0.35rem;
    }
    .career-entry h3 {
      font-size: 1rem;
    }
  }
</style>
