---
import { ME } from "../config";
import { primaryEducation } from "../data/career";
import { getTechView } from "../data/techRegistry";
import { formatDate } from "../utils/formatDate";
const edu = primaryEducation();
---

<aside
  id="profile-sidebar"
  class="profile-panel cad-border"
  aria-label="Background and toolkit"
>
  <p class="section-kicker">Background & toolkit</p>
  {
    edu && (
      <div class="profile-block">
        <>
          <h3>Education</h3>
          <p class="education-title">{edu.title}</p>
          <p class="profile-detail">{edu.school}</p>
          <p class="profile-detail">
            {edu.endDate ? formatDate(new Date(edu.endDate)) : ""}
          </p>
        </>
      </div>
    )
  }
  <div class="profile-block">
    <h3>Core languages</h3><div class="language-grid">
      {
        ME.coreLanguages.map((tech) => {
          const { displayName, iconPath } = getTechView(tech);
          return (
            <div class="language-item">
              {iconPath && (
                <img
                  src={iconPath}
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span>{displayName}</span>
            </div>
          );
        })
      }
    </div>
  </div>
  <div class="profile-block">
    <h3>Areas of practice</h3><ul class="competencies">
      {
        ME.competencies.map((item) => (
          <li>
            <span aria-hidden="true">+</span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="profile-block">
    <h3>Communication</h3><div class="communication">
      {
        ME.languages.map((lang) => (
          <div>
            <>
              <span>{lang.name}</span>
              <span class="profile-detail">{lang.level}</span>
            </>
          </div>
        ))
      }
    </div>
  </div>
  <a
    class="text-link focus-ring"
    href={`/${ME.contactInfo.resumeDoc}`}
    target="_blank"
    rel="noopener noreferrer"
    >The full résumé <span aria-hidden="true">↗</span></a
  >
</aside>

<style>
  .profile-panel {
    overflow-wrap: anywhere;
    padding: 1.25rem;
    border-radius: 4px;
    background: rgb(15 23 42 / 70%);
  }
  .profile-panel > .section-kicker {
    margin-bottom: 1.75rem;
    font-size: 0.75rem;
  }
  .profile-block {
    border-bottom: 1px solid #2b394c;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .profile-block h3 {
    color: #94a3b8;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.8rem;
  }
  .education-title {
    font-weight: 550;
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }
  .profile-detail {
    color: #a6b5c8;
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .language-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }
  .language-item {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-family: var(--font-display);
    font-size: 0.8rem;
  }
  .competencies {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: #cbd5e1;
  }
  .competencies li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .competencies li span {
    color: #b6e5d3;
  }
  .communication {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .communication > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
</style>
