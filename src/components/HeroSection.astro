---
import SiteImage from "@/components/SiteImage.astro";
import { ME, SOCIALS } from "../config";
import { timelineJobs, primaryEducation } from "../data/career";
import portraitLineart from "../assets/portrait-lineart.svg";
import ForestScene from "./ForestScene.astro";

interface Props {
  staticTerrain?: boolean;
}

const { staticTerrain = true } = Astro.props;

const currentJob = timelineJobs().find((job) => job.currentJob);
const education = primaryEducation();
---

<section class="hero-section" aria-label="Introduction">
  <div class="hero-main">
    <div class="hero-copy">
      <div class="hero-name">
        <h1 class="text-5xl md:text-7xl font-display font-bold mb-4 leading-tight">
          {ME.name}
        </h1>
      </div>
      <p class="hero-profession">{ME.profession.join(" / ")}</p>
      <h2 class="hero-headline">
        {ME.headline.map((line) => <span>{line}</span>)}
      </h2>
      {/* One copy per breakpoint so the server HTML already has the settled order; the hidden copy is display: none, so it is out of the accessibility tree. */}
      <p class="hero-description" data-breakpoint="desktop">{ME.aboutMe}</p>
      <div class="hero-actions">
        <a class="cta-primary focus-ring" href="#projects"
          >Explore my work <span aria-hidden="true">↗</span></a
        >
        <a
          class="text-link focus-ring"
          href={`/${ME.contactInfo.resumeDoc}`}
          target="_blank"
          rel="noopener noreferrer"
          >View résumé <span aria-hidden="true">↗</span></a
        >
        <button
          type="button"
          class="scenery-control focus-ring"
          aria-label="Pause scenery animation"
        >
          <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
            <path
              class="pause-icon"
              d="M5 3V13M11 3V13"
              fill="none"
              stroke="currentColor"
              stroke-width="2"></path>
            <path class="play-icon" d="M4 2 13 8 4 14Z" fill="currentColor"
            ></path>
          </svg>
        </button>
      </div>
      <p class="hero-description" data-breakpoint="mobile">{ME.aboutMe}</p>
    </div>
    <div class="portrait-column">
      <div class="portrait-illustration">
        <SiteImage
          src={portraitLineart}
          alt={`${ME.name} illustrated portrait`}
          class="portrait-image"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <p class="portrait-note font-display">
        {ME.portraitNote}<span class="iteration-dots" aria-hidden="true"
          >...</span
        >
      </p>
      <div class="hero-socials">
        {
          SOCIALS.filter((social) => social.show).map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-link focus-ring"
            >
              {social.name}
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
        <a href={`mailto:${ME.contactInfo.email}`} class="text-link focus-ring"
          >Email<span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </div>
  <div class="hero-context">
    {
      currentJob && (
        <div>
          <>
            <span class="context-label">Currently</span>
            <p>
              {currentJob.title}
              <span class="context-detail">at {currentJob.company}</span>
            </p>
          </>
        </div>
      )
    }
    {
      education && (
        <div>
          <>
            <span class="context-label">Foundation</span>
            <p>
              {education.title}
              <span class="context-detail">{education.school}</span>
            </p>
          </>
        </div>
      )
    }
    <div>
      <span class="context-label">Working across</span><p>
        {ME.focusAreas.map((area) => <span class="context-focus">{area}</span>)}
      </p>
    </div>
  </div>
  {/* Decorative scenery follows the content: on phones it is placed from the hero's bottom, so a first paint before the content parsed would drop it in the wrong place. */}
  <div class="hero-landscape">
    <ForestScene staticTerrain={staticTerrain} />
  </div>
</section>

<style>
  .scenery-control {
    z-index: 2;
    position: relative;
    flex-shrink: 0;
    pointer-events: auto;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    color: #b6c6da;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .scenery-control[hidden] {
    display: none;
  }
  /* Present from first paint wherever it works, rather than revealed by the script. */
  @media (scripting: none), (prefers-reduced-motion: reduce) {
    .scenery-control {
      display: none;
    }
  }
  .scenery-control:hover {
    color: #f0fff9;
  }
  .play-icon {
    display: none;
  }
  [data-user-paused="true"] .pause-icon {
    display: none;
  }
  [data-user-paused="true"] .play-icon {
    display: block;
  }
  .scenery-control::before {
    content: "";
    position: absolute;
    inset: 6px;
    border: 1px solid color-mix(in srgb, #b6e5d3 30%, #111c2e);
    background: #111c2e;
    border-radius: 50%;
  }
  .scenery-control > svg {
    position: relative;
  }
  .scenery-control:hover::before {
    border-color: color-mix(in srgb, #b6e5d3 60%, #111c2e);
  }

  .hero-section {
    overflow-wrap: anywhere;
    margin: 0 0 2.5rem;
    position: relative;
    isolation: isolate;
  }
  .hero-landscape {
    position: absolute;
    top: -5rem;
    bottom: 0;
    left: calc((100% - 100vw) / 2);
    width: 100vw;
    overflow: clip;
    z-index: -1;
    pointer-events: none;
  }
  .hero-main {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: start;
    gap: 4rem;
    padding: 0.5rem 0 1.5rem;
  }
  .hero-copy {
    min-width: 0;
  }
  .hero-name :global(h1) {
    font-size: clamp(2.4rem, 4.3vw, 3.75rem);
    letter-spacing: -0.04em;
    font-weight: 650;
    line-height: 1.18;
    margin-bottom: 0.75rem;
  }
  .hero-profession {
    font-family: var(--font-display);
    font-size: 0.8rem;
    line-height: 1.8;
    color: #b6c6da;
  }
  .hero-headline {
    font-family: var(--font-body);
    font-size: clamp(2rem, 3.1vw, 2.75rem);
    line-height: 1.16;
    letter-spacing: -0.04em;
    font-weight: 550;
    margin: 1.5rem 0 1rem;
  }
  .hero-headline span {
    display: block;
  }
  .hero-headline span:last-child {
    color: #b6e5d3;
  }
  .hero-description[data-breakpoint="mobile"] {
    display: none;
  }
  .hero-description {
    color: #cbd5e1;
    font-size: 1rem;
    line-height: 1.85;
    max-width: 34rem;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.8rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .hero-actions .cta-primary {
    padding: 0.9rem 1.25rem;
    gap: 1.4rem;
  }
  .portrait-column {
    width: 100%;
    max-width: 21rem;
    justify-self: end;
    padding-top: 1rem;
  }
  .portrait-illustration {
    position: relative;
    width: min(100%, 21.5rem);
    margin-inline: auto;
    isolation: isolate;
  }
  .portrait-illustration::before {
    content: "";
    position: absolute;
    inset: -2rem 0;
    z-index: -1;
    background: radial-gradient(
      ellipse,
      #0f172ae6 0%,
      #0f172a99 38%,
      transparent 72%
    );
    pointer-events: none;
  }
  .portrait-image {
    display: block;
    width: 100%;
    height: auto;
    mask-image: linear-gradient(
      to bottom,
      var(--color-background-dark) 88%,
      transparent 100%
    );
  }
  .portrait-note {
    max-width: 20rem;
    margin: 0.9rem auto 0;
    text-align: center;
    color: #a9bacd;
    font-family: var(--font-display);
    font-size: 0.75rem;
    line-height: 1.65;
  }
  .iteration-dots {
    display: inline-block;
    width: 3ch;
    white-space: nowrap;
    clip-path: inset(0 100% 0 0);
    animation: iteration-dots 1.4s steps(1, end) infinite;
  }
  /* Set by the script below while the note is offscreen: the steps() animation otherwise restyles every frame. */
  .portrait-note[data-offscreen] .iteration-dots {
    animation-play-state: paused;
  }
  @keyframes iteration-dots {
    0% {
      clip-path: inset(0 100% 0 0);
    }
    25% {
      clip-path: inset(0 66.6667% 0 0);
    }
    50% {
      clip-path: inset(0 33.3333% 0 0);
    }
    75%,
    100% {
      clip-path: inset(0 0 0 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .iteration-dots {
      animation: none;
      clip-path: none;
    }
  }
  .hero-socials {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 0.75rem;
  }
  .hero-socials a {
    font-size: 0.75rem;
    gap: 0.35rem;
  }
  .hero-context {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    border-top: 1px solid var(--color-slate-700);
    border-bottom: 1px solid var(--color-slate-700);
    padding: 1.25rem 0;
  }
  .context-label {
    display: block;
    color: var(--color-accent);
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.6rem;
  }
  .hero-context p {
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.65;
  }
  .context-detail {
    display: block;
    font-weight: 400;
    color: var(--color-accent);
    font-size: 0.78rem;
    margin-top: 0.15rem;
  }
  .context-focus {
    display: block;
    font-weight: 400;
    font-size: 0.78rem;
    color: #cbd5e1;
  }
  @media (max-width: 1023px) {
    .hero-main {
      gap: 2.5rem;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }
    .hero-name :global(h1) {
      font-size: clamp(2.4rem, 5vw, 3.5rem);
    }
  }
  @media (max-width: 767px) {
    .hero-description[data-breakpoint="desktop"] {
      display: none;
    }
    .hero-description[data-breakpoint="mobile"] {
      display: block;
    }
    .hero-landscape {
      top: auto;
      bottom: 8rem;
      height: 17rem;
    }
    .hero-section {
      margin: 0.5rem 0 1rem;
    }
    .hero-main {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-bottom: 1rem;
    }
    .hero-name :global(h1) {
      font-size: clamp(2rem, 7.7vw, 3.5rem);
    }
    .hero-headline {
      font-size: clamp(1.8rem, 6vw, 2.5rem);
      margin-top: 1.25rem;
    }
    .hero-profession {
      font-size: 0.75rem;
    }
    .hero-actions {
      gap: 0.75rem 0.6rem;
      margin-top: 0;
      margin-bottom: 1rem;
    }
    .hero-actions a {
      min-height: 44px;
    }
    .hero-actions .cta-primary {
      padding: 0.75rem 0.9rem;
      gap: 0.6rem;
    }
    .portrait-column {
      max-width: 100%;
      justify-self: start;
      display: grid;
      grid-template-columns: min(7rem, 40%) minmax(0, 1fr);
      gap: 0 0.9rem;
      align-items: center;
      padding-top: 0;
    }
    .portrait-illustration {
      grid-row: 1 / 3;
      width: min(7rem, 100%);
    }
    .portrait-illustration::before {
      inset: -1rem 0;
    }
    .portrait-note {
      max-width: none;
      margin: 0;
      text-align: left;
      font-size: 0.75rem;
      line-height: 1.6;
      align-self: end;
    }
    .hero-socials {
      justify-content: start;
      align-self: start;
      gap: 0.1rem 0.75rem;
      margin-top: 0.3rem;
    }
    .hero-socials a {
      font-size: 0.75rem;
      min-height: 2.75rem;
    }
    .hero-context {
      padding-block: 0.75rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
    .hero-context > div:last-child {
      grid-column: 1 / -1;
    }
    .hero-context > div:last-child p {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
    }
    .hero-context p {
      font-size: 0.8rem;
    }
    .context-detail {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  let cleanupDots: (() => void) | undefined;
  document.addEventListener("astro:before-swap", () => {
    cleanupDots?.();
    cleanupDots = undefined;
  });
  document.addEventListener("astro:page-load", () => {
    cleanupDots?.();
    cleanupDots = undefined;
    const note = document.querySelector<HTMLElement>(".portrait-note");
    if (!note || !("IntersectionObserver" in window)) return;
    const observer = new IntersectionObserver(([entry]) => {
      note.toggleAttribute("data-offscreen", !entry.isIntersecting);
    });
    observer.observe(note);
    cleanupDots = () => observer.disconnect();
  });
</script>
