---

---

<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  tabindex="-1"
  aria-hidden="true"
  class="fixed bottom-8 right-8 z-50 flex h-12 w-12 flex-col items-center justify-center gap-0.5 border border-slate-400/70 bg-slate-900 backdrop-blur-sm text-slate-400 opacity-0 pointer-events-none hover:text-white hover:border-slate-200/60 focus-ring"
  style="transition: opacity 200ms ease, color 200ms ease, border-color 200ms ease;"
>
  <span
    class="absolute -top-1 -left-1 w-2 h-2 border-t border-l border-slate-400/50 transition-opacity duration-300"
  ></span>
  <span
    class="absolute -bottom-1 -right-1 w-2 h-2 border-b border-r border-slate-400/50 transition-opacity duration-300"
  ></span>
  <svg
    class="transition-opacity duration-300"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="m18 15-6-6-6 6"></path>
  </svg>
  <span
    class="text-[9px] uppercase tracking-widest font-display leading-none transition-opacity duration-300"
    >TOP</span
  >
</button>

<script>
  import { initBackToTop } from "../utils/backToTop";

  let cleanup: (() => void) | undefined;
  document.addEventListener("astro:before-swap", () => cleanup?.());
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    const btn = document.getElementById("back-to-top");
    if (btn) cleanup = initBackToTop(btn);
  });
</script>
