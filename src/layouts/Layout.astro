---
import { ClientRouter } from "astro:transitions";
import "@/styles/globals.css";

import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TopoBackground from "../components/TopoBackground.tsx";
import LoadingOverlay from "../components/LoadingOverlay.tsx";
import BackToTop from "../components/BackToTop.astro";
import FieldMapScenery from "../components/FieldMapScenery.astro";

import { SITE } from "@/config";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

// Resolve hashed font URLs at build time for preloading
import plexSansLatinUrl from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import jbMonoLatinUrl from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  scrollSmooth?: boolean;
  description?: string;
  imageOg?: string;
  heroImage?: ImageMetadata;
  fieldMap?: boolean;
  storyFont?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  scrollSmooth = false,
  imageOg = SITE.ogImage,
  heroImage,
  fieldMap = false,
  storyFont = false,
} = Astro.props;

const heroPreload = heroImage
  ? await getImage({
      src: heroImage,
      layout: "constrained",
      format: heroImage.format === "svg" ? "svg" : "avif",
      quality: 80,
      fit: "cover",
      position: "center",
    })
  : undefined;

const tags = SITE.tags;
const author = SITE.author;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const absoluteOgImage = new URL(imageOg, Astro.site).href;
---

<!doctype html>
<html
  lang={SITE.lang ?? "en"}
  class:list={["dark", "bg-background-dark", { "scroll-smooth": scrollSmooth }]}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    {/* Preload critical fonts — eliminates CSS→parse→download waterfall */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={plexSansLatinUrl}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={jbMonoLatinUrl}
      crossorigin
    />
    {
      storyFont && (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href="/project-story/WixMadeforText.woff2"
          crossorigin
        />
      )
    }

    {
      heroPreload && (
        <link
          rel="preload"
          as="image"
          href={heroPreload.src}
          imagesrcset={heroPreload.srcSet.attribute}
          imagesizes={heroPreload.attributes.sizes}
          fetchpriority="high"
        />
      )
    }

    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={tags.join(", ")} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href={SITE.favicon} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={absoluteOgImage} />
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={absoluteOgImage} />

    <title>{title}</title>
    <ClientRouter />
    <script>
      import { initPageTransitions } from "@/utils/pageTransition";
      initPageTransitions();
    </script>

    {
      /* Speculation Rules API — prerender same-origin pages on hover for instant navigation.
        Chromium-only (Chrome, Edge, Opera); ignored by other browsers.
        "moderate" eagerness triggers on hover/pointerdown — prerenders the full page
        so navigations are near-instant (0ms perceived load). */
    }
    <script type="speculationrules">
      {
        "prerender": [
          {
            "source": "document",
            "where": { "href_matches": "/*" },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body
    data-field-map={fieldMap || undefined}
    class="min-h-screen bg-transparent font-body text-slate-800 dark:text-slate-200 selection:bg-primary selection:text-white"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
      >Skip to main content</a
    >

    <script is:inline>
      document.documentElement.classList.add("dark");
    </script>

    <LoadingOverlay client:only="react" />
    <div class="topo-layer">
      <TopoBackground
        client:only="react"
        transition:persist="topo-background"
      />
    </div>
    <BackToTop />
    <SiteHeader />
    {fieldMap && <FieldMapScenery />}

    <main
      id="main-content"
      tabindex="-1"
      class="relative z-10 max-w-7xl mx-auto px-6 py-10 md:py-12"
    >
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :global(body[data-field-map]) {
    position: relative;
  }
  /* display: none, not visibility: hidden: the topo filter animates every frame and a hidden layer still repaints. */
  :global(body[data-field-map] .topo-layer) {
    display: none;
  }
</style>
