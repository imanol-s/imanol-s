---
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../config";
import ProjectsCarousel from "../../components/ProjectsCarousel.astro";
---

<Layout
  title={`${SITE.logoText} | Projects`}
  description="Selected work in robotics, databases, algorithms, and data analysis. The problem, the contribution, and what each project taught me."
>
  <header class="mb-12 max-w-3xl">
    <p class="section-kicker">Project notebook</p>
    <h1 class="section-heading">The work behind the skills.</h1>
    <p class="section-intro">
      From a navigation policy to a normalized database: a closer look at the
      problems, the decisions, and the lessons along the way.
    </p>
  </header>
  <ProjectsCarousel showHeading={false} />
</Layout>

<style>
  header .section-kicker {
    margin-bottom: 1rem;
  }
  header .section-intro {
    margin-top: 0.8rem;
  }
</style>
