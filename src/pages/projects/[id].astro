---
import { getCollection, render } from "astro:content";
import { netlifyImage } from "@/utils/netlifyImage";
import Layout from "../../layouts/Layout.astro";
import TagPill from "../../components/TagPill.astro";
import { SITE } from "../../config";
import { formatDate } from "../../utils/formatDate";
import {
  getSortedProjects,
  getProjectPageData,
} from "../../data/projectCollection";

export async function getStaticPaths() {
  const sorted = getSortedProjects(await getCollection("projects"));
  return sorted.map((post) => ({
    params: { id: post.id },
    props: { post, sorted },
  }));
}

const { post, sorted } = Astro.props;
const { title, summary, tags, cover, url, startDate, endDate } = post.data;
const { Content } = await render(post);
const { prev, next, hasValidUrl } = getProjectPageData(sorted, post.id);
const artworkAlt =
  post.id === "automaton"
    ? "Watercolor concept illustration of input sheets leading to a browser window with a gear and a checked run journal"
    : post.id === "sensori-robotics"
      ? "Watercolor illustration of a wheeled robot following a route around block obstacles"
      : post.id === "pert-scheduling"
        ? "Watercolor illustration of task cards connected by branching dependency arrows and a completion check mark"
        : post.id === "crime-analysis"
          ? "Watercolor illustration of houses on a map beside a magnifying glass over a bar chart"
          : "Watercolor illustration of books, an open book, and a library card catalog";
---

<Layout
  title={title}
  description={summary}
  imageOg={cover.format === "svg" ? SITE.ogImage : cover.src}
  scrollSmooth={true}
  heroImage={cover}
  heroSizes="(min-width: 1280px) 1232px, calc(100vw - 48px)"
>
  <nav aria-label="Breadcrumb" class="mb-10">
    <a
      href="/projects"
      class="text-link focus-ring font-display inline-flex items-center gap-2 text-xs"
    >
      <span aria-hidden="true">←</span> All projects
    </a>
  </nav>

  <header class="project-header">
    <h1 class="font-display">{title}</h1>
    <p class="project-summary">{summary}</p>
    {
      (startDate || endDate || hasValidUrl) && (
        <div class="project-hero-meta font-display">
          {(startDate || endDate) && (
            <span>
              {startDate && endDate
                ? `${formatDate(startDate)} to ${formatDate(endDate)}`
                : startDate
                  ? `Started ${formatDate(startDate)}`
                  : endDate
                    ? `Completed ${formatDate(endDate)}`
                    : ""}
            </span>
          )}
          {hasValidUrl && (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-link focus-ring"
            >
              View repository{" "}
              <>
                <span aria-hidden="true">↗</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </>
            </a>
          )}
        </div>
      )
    }
  </header>

  <figure class={`project-figure project-${post.id} cad-border`}>
    <div class="project-artwork">
      <img
        {...netlifyImage(cover)}
        alt={artworkAlt}
        class="project-cover"
        sizes="(min-width: 1280px) 1232px, calc(100vw - 48px)"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </figure>

  <div class="project-body">
    <article class="project-story prose dark:prose-invert max-w-none">
      <Content />
    </article>
    <aside class="project-sidebar" aria-label="Project details">
      <div class="project-stack cad-border">
        <p class="section-kicker">Tools &amp; techniques</p>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag: string) => <TagPill techId={tag} />)}
        </div>
      </div>
      <a href="/projects" class="project-back text-link focus-ring font-display"
        >Browse more work <span aria-hidden="true">↗</span></a
      >
    </aside>
  </div>

  <nav class="project-pagination" aria-label="More projects">
    {
      prev ? (
        <a
          href={`/projects/${prev.id}`}
          class="project-pagination-link focus-ring"
        >
          <span class="font-display">← Previous project</span>
          <strong class="font-display">{prev.data.title}</strong>
        </a>
      ) : (
        <div aria-hidden="true" />
      )
    }
    {
      next && (
        <a
          href={`/projects/${next.id}`}
          class="project-pagination-link project-next focus-ring"
        >
          <span class="font-display">Next project →</span>
          <strong class="font-display">{next.data.title}</strong>
        </a>
      )
    }
  </nav>
</Layout>

<style>
  .project-header {
    max-width: 58rem;
    margin-bottom: 2.5rem;
  }
  .project-header h1 {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.055em;
    margin-bottom: 1.25rem;
  }
  .project-summary {
    max-width: 65ch;
    color: #475569;
    font-size: 1.1rem;
    line-height: 1.8;
  }
  .project-hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    font-size: 0.75rem;
    color: #475569;
  }
  .project-hero-meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .project-figure {
    overflow: hidden;
    border-radius: 4px;
  }
  .project-artwork {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: #f6f9fc;
  }
  .project-artwork :global(.project-cover) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .project-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 4rem;
    margin-top: 3.5rem;
    align-items: start;
  }
  .project-story {
    font-size: 1rem;
    line-height: 1.9;
  }
  .project-story :global(h2:first-child) {
    margin-top: 0;
  }
  .project-story :global(h2) {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .project-story :global(p) {
    max-width: 68ch;
  }
  .project-story :global(.analysis-figure) {
    width: 100%;
    margin: 2rem 0;
  }
  .project-story :global(.analysis-map) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 4px;
  }
  .project-stack {
    padding: 1.5rem;
    border-radius: 4px;
    background: #fff;
  }
  .project-stack .section-kicker {
    font-size: 0.65rem;
    margin-bottom: 1.25rem;
  }
  .project-back {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    font-size: 0.7rem;
  }
  .project-pagination {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;
  }
  .project-pagination-link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 20rem;
    color: #334155;
  }
  .project-pagination-link span {
    font-size: 0.65rem;
    color: #475569;
  }
  .project-pagination-link strong {
    font-size: 0.85rem;
    line-height: 1.7;
    font-weight: 500;
  }
  .project-pagination-link:hover,
  .project-pagination-link:hover span {
    color: #0f172a;
  }
  .project-next {
    text-align: right;
    align-items: flex-end;
  }
  :global(.dark) .project-summary,
  :global(.dark) .project-hero-meta {
    color: #cbd5e1;
  }
  :global(.dark) .project-pagination {
    border-color: #334155;
  }
  :global(.dark) .project-stack {
    background: #111c2e;
  }
  :global(.dark) .project-pagination-link {
    color: #e2e8f0;
  }
  :global(.dark) .project-pagination-link span {
    color: #cbd5e1;
  }
  :global(.dark) .project-pagination-link:hover,
  :global(.dark) .project-pagination-link:hover span {
    color: #fff;
  }
  @media (min-width: 1024px) {
    .project-sidebar {
      position: sticky;
      top: 7rem;
    }
  }
  @media (max-width: 1023px) {
    .project-body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .project-sidebar {
      grid-row: 1;
    }
    .project-stack {
      padding: 1.25rem;
    }
    .project-back {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .project-header h1 {
      letter-spacing: -0.04em;
    }
    .project-summary {
      font-size: 1rem;
    }

    .project-body {
      margin-top: 2rem;
    }
    .project-pagination {
      gap: 1.25rem;
    }
    .project-pagination-link strong {
      font-size: 0.75rem;
    }
  }
</style>
