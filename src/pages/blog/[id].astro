---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BackBtn from "../../components/BackBtn.astro";
import { netlifyImage } from "@/utils/netlifyImage";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const { title, description, tags, cover } = post.data;

const { Content } = await render(post);
---

<Layout
  title={title}
  description={description}
  imageOg={new URL(cover.src.src, Astro.site).href}
  scrollSmooth={true}
  heroImage={cover.src}
  heroSizes="(min-width: 1280px) 1232px, calc(100vw - 48px)"
>
  <div class="flex justify-center mt-10">
    <BackBtn />
  </div>
  <div class="flex flex-col gap-6 justify-center items-center">
    <h1 class="text-3xl font-display font-bold text-center">{title}</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400">
      {tags.join(", ")}
    </p>
  </div>
  <div class="cad-border overflow-hidden">
    <img
      transition:name={`${post.id}-image`}
      class="w-full h-[400px] object-cover"
      {...netlifyImage(cover.src)}
      alt={cover.alt ?? title}
      sizes="(min-width: 1280px) 1232px, calc(100vw - 48px)"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <article id="article" class="mt-8 prose dark:prose-invert scroll-mt-20">
    <Content />
  </article>
</Layout>
